{
  "openapi": "3.1.0",
  "info": {
    "title": "Murafaa API",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/auth/otp": {
      "post": {
        "operationId": "authRequestOtp",
        "tags": [
          "Auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "error"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/RequestOtpResponse"
                    },
                    "error": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOtpBody"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "operationId": "authVerify",
        "tags": [
          "Auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "error"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/VerifyOtpResponse"
                    },
                    "error": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpBody"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "authCurrent",
        "tags": [
          "Auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "error"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Me"
                    },
                    "error": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "tags": [
          "Auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "error"
                  ],
                  "properties": {
                    "data": {},
                    "error": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "healthCheck",
        "tags": [
          "Health"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "error"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Health"
                    },
                    "error": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/offices/current": {
      "get": {
        "operationId": "officesCurrent",
        "tags": [
          "Offices"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "error"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Office"
                    },
                    "error": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": [
          "data",
          "error"
        ],
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "RATE_LIMITED",
              "OTP_EXPIRED",
              "OTP_INVALID",
              "OTP_TOO_MANY_ATTEMPTS",
              "TOTP_REQUIRED",
              "TOTP_INVALID",
              "IP_NOT_ALLOWED",
              "INTERNAL"
            ]
          },
          "messageKey": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "messageKey"
        ],
        "additionalProperties": false
      },
      "RequestOtpResponse": {
        "type": "object",
        "properties": {
          "sent": {
            "type": "boolean",
            "const": true
          },
          "devCode": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "sent"
        ],
        "additionalProperties": false
      },
      "RequestOtpBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 20
          },
          "channel": {
            "default": "whatsapp",
            "type": "string",
            "enum": [
              "sms",
              "whatsapp"
            ]
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "officeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "PARTNER",
              "LAWYER",
              "ASSISTANT",
              "ACCOUNTANT",
              "ADMIN",
              "RECEPTION"
            ]
          },
          "previewRole": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PARTNER",
                  "LAWYER",
                  "ASSISTANT",
                  "ACCOUNTANT",
                  "ADMIN",
                  "RECEPTION"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "officeId",
          "name",
          "role",
          "previewRole"
        ],
        "additionalProperties": false
      },
      "VerifyOtpBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 20
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "totp": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "office": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "today",
                "dashboard",
                "settings",
                "notifications",
                "clientportal",
                "empportal",
                "search",
                "accountSecurity",
                "cases",
                "workspace",
                "copilot",
                "clients",
                "leads",
                "documents",
                "kb",
                "finance",
                "billing",
                "hr",
                "journey",
                "activity",
                "perms",
                "whatsapp",
                "deadlines",
                "appointments",
                "tasks",
                "alerts",
                "pulse"
              ]
            }
          },
          "modules": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "CASES",
                "AI",
                "CLIENTS",
                "DOCUMENTS",
                "FINANCE",
                "HR",
                "REPORTS",
                "PERMISSIONS",
                "WHATSAPP",
                "APPOINTMENTS",
                "TASKS",
                "ALERTS",
                "PULSE"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "NONE",
                "VIEW",
                "EDIT",
                "FULL"
              ]
            },
            "required": [
              "CASES",
              "AI",
              "CLIENTS",
              "DOCUMENTS",
              "FINANCE",
              "HR",
              "REPORTS",
              "PERMISSIONS",
              "WHATSAPP",
              "APPOINTMENTS",
              "TASKS",
              "ALERTS",
              "PULSE"
            ]
          },
          "isPartner": {
            "type": "boolean"
          }
        },
        "required": [
          "user",
          "office",
          "screens",
          "modules",
          "isPartner"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "version"
        ],
        "additionalProperties": false
      },
      "Office": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  }
}
