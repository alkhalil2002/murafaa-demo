NODE_ENV=development
PORT=4000
# Non-owner login (member of murafaa_app) so row-level security applies.
DATABASE_URL=postgres://murafaa_api:murafaa_api@localhost:5440/murafaa_dev
CORS_ORIGINS=http://localhost:3000
# strict: routes without a declared permission are denied. Required in production.
RBAC_ENFORCEMENT=strict
LOG_LEVEL=info
# HMAC key for stored OTP codes (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef
# AES-256-GCM key for TOTP secrets (32 bytes, base64). Generate: openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
# console = dev only (code shown in the login form and logged); unifonic = real delivery (not connected yet)
OTP_PROVIDER=console
# Document storage: local (dev, files under apps/api/.storage) or gcs (production, me-central2 bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# GCS_BUCKET=murafaa-documents-me-central2
