{
  "name": "@murafaa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/src/main.js)",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "openapi": "node dist/scripts/openapi.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.6",
    "@murafaa/auth": "workspace:*",
    "@murafaa/contracts": "workspace:*",
    "@murafaa/database": "workspace:*",
    "@murafaa/documents": "workspace:*",
    "@murafaa/i18n": "workspace:*",
    "@murafaa/rules": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@murafaa/config": "workspace:*",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "postgres": "3.4.9",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
