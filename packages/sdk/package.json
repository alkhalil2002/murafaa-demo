{
  "name": "@murafaa/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed API client generated from apps/api/openapi.json. Do not edit src/gen by hand.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "generate": "openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@murafaa/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
