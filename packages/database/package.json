{
  "name": "@murafaa/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and the tenant-scoped client (RLS on office_id).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@murafaa/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  }
}
