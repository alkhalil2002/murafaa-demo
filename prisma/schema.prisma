// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

/// A law office = one tenant. Every business row hangs off an Office.
model Office {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  /// Letterhead / branding used by all generated PDFs (name, tagline, contact,
  /// license, colors, confidentiality notice, logo key). Null → code defaults.
  branding        Json?
  /// Governance: when on, new payments/expenses await partner approval.
  requireApproval Boolean   @default(false) @map("require_approval")
  /// Staff login IP allowlist (exact addresses or CIDR-style prefixes as plain
  /// strings, matched by src/lib/security/ip.ts). Empty = unrestricted (default).
  ipAllowlist     String[]  @default([]) @map("ip_allowlist")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  users                User[]
  clients              Client[]
  cases                Case[]
  leads                Lead[]
  tasks                Task[]
  appointments         Appointment[]
  hearings             Hearing[]
  caseEvents           CaseEvent[]
  caseReminders        CaseReminder[]
  conflictFlags        ConflictFlag[]
  documents            Document[]
  documentTemplates    DocumentTemplate[]
  invoices             Invoice[]
  payments             Payment[]
  creditNotes          CreditNote[]
  expenses             Expense[]
  timeEntries          TimeEntry[]
  feeAgreements        CaseFeeAgreement[]
  trustAccounts        TrustAccount[]
  trustTransactions    TrustTransaction[]
  chartOfAccounts      ChartOfAccount[]
  journalEntries       JournalEntry[]
  accountingPeriods    AccountingPeriod[]
  aiInteractions       AiInteraction[]
  permissions          Permission[]
  fieldDenies          FieldPermission[]
  caseScopes           RoleCaseScope[]
  auditLogs            AuditLog[]
  otps                 OtpChallenge[]
  employees            Employee[]
  advances             Advance[]
  leaves               Leave[]
  attendance           Attendance[]
  candidates           Candidate[]
  integrationConnections IntegrationConnection[]
  employeeRequests     EmployeeRequest[]
  payrollRuns          PayrollRun[]
  performanceEvents    PerformanceEvent[]
  caseApprovals        CaseApproval[]
  caseExecutions       CaseExecution[]
  procedureRequests    ProcedureRequest[]
  clientCommunications ClientCommunication[]
  caseMessages         CaseMessage[]
  contracts            Contract[]

  @@map("offices")
}

// ─────────────────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  name     String
  /// E.164 phone, unique per office (OTP login identifier).
  phone    String
  role     Role
  /// Owner is modeled as PARTNER — there is no implicit god mode.
  isActive Boolean @default(true) @map("is_active")

  /// TOTP two-factor secret (base32), set once 2FA is confirmed-enabled.
  totpSecret  String? @map("totp_secret")
  totpEnabled Boolean @default(false) @map("totp_enabled")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  assignedCases     CaseAssignee[]
  auditLogs         AuditLog[]
  tasks             Task[]             @relation("TaskAssignee")
  waivedConflicts   ConflictFlag[]     @relation("ConflictWaivedBy")
  timeEntries       TimeEntry[]        @relation("TimeEntryLawyer")
  employee          Employee?          @relation("EmployeeUser")
  performanceEvents PerformanceEvent[]

  @@unique([officeId, phone])
  @@index([officeId])
  @@map("users")
}

/// One-time password challenge for phone/WhatsApp login (docs/02 §8).
/// The code is stored hashed; the row is short-lived and attempt-limited.
model OtpChallenge {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([officeId, phone])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ─────────────────────────────────────────────────────────────────────────
// RBAC — the editable matrix (docs/04). Enforced server-side, all 3 layers.
// ─────────────────────────────────────────────────────────────────────────

/// Layer 1: module access. (office, role, module) → level.
model Permission {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  role   Role
  module PermModule
  level  PermLevel

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([officeId, role, module])
  @@index([officeId])
  @@map("permissions")
}

/// Layer 2: field denial. (office, role, resource, field) is denied.
/// Seeded example: ASSISTANT is denied the "fees" field on cases.
model FieldPermission {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  role     Role
  resource String
  field    String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([officeId, role, resource, field])
  @@index([officeId])
  @@map("field_permissions")
}

/// Layer 3: row scope for cases. (office, role) → ALL | ASSIGNED.
model RoleCaseScope {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  role  Role
  scope CaseScope

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([officeId, role])
  @@index([officeId])
  @@map("role_case_scopes")
}

// ─────────────────────────────────────────────────────────────────────────
// Core domain (minimal for Phase 1 — expanded in Phase 2)
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id       String @id @default(uuid()) @map("id") @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  name   String
  phone  String?
  city   String?
  type   ClientType   @default(INDIVIDUAL)
  status ClientStatus @default(ACTIVE)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  cases         Case[]
  appointments  Appointment[]
  invoices      Invoice[]
  creditNotes   CreditNote[]
  expenses      Expense[]
  trustAccount  TrustAccount?
  convertedFrom Lead[]         @relation("LeadConvertedClient")
  conflictFlags ConflictFlag[] @relation("ConflictMatchedClient")

  // phone is the client-portal login key; unique per office when present
  // (Postgres allows multiple NULLs, so phone-less clients are fine).
  @@unique([officeId, phone])
  @@index([officeId])
  @@map("clients")
}

model Case {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Display number (e.g. "1445/...").
  number String
  title  String

  /// Our client's litigation capacity (prototype case.role).
  clientRole PartyRole @default(PLAINTIFF) @map("client_role")

  /// Our client (FK, replacing the prototype's name-string link).
  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id])

  /// Opposing party — the axis of conflict-of-interest detection (docs/06 §4).
  /// Free text (no FK): the opponent is not necessarily in our system.
  opposingParty String? @map("opposing_party")

  /// Optional free-text entity/organization on our side (prototype "الجهة"), distinct from the linked client.
  entity String?

  /// Najiz classification (main → sub → leaf). Stored as strings validated
  /// against the NajizClassification reference table.
  najizMainClass String? @map("najiz_main_class")
  najizSubClass  String? @map("najiz_sub_class")
  najizCaseType  String? @map("najiz_case_type")

  city String?

  /// Baseline procedural stage. The EFFECTIVE stage is derived from the latest
  /// held hearing (see cases service stageOf); this is the manual floor.
  stage   ProcStage    @default(FIRST_INSTANCE)
  status  CaseStatus   @default(ACTIVE)
  outcome CaseOutcome?

  /// Lawyer-authored fact summary (fed into AI context in Phase 5).
  factSummary String? @map("fact_summary")

  /// Judgment pronouncement date — the source for the objection deadline.
  judgmentDate DateTime? @map("judgment_date")

  /// Objection deadline = judgment date + 30 days (docs/06 §1). Nullable until
  /// judgment is recorded; computed by the service layer, never the UI.
  objectionDueAt DateTime? @map("objection_due_at")

  /// Power-of-attorney (الوكالة الشرعية) expiry — surfaced as a deadline.
  poaExpiresAt DateTime? @map("poa_expires_at")

  /// Increments on "إعادة" (arena reset, prototype arenaReset()) — the arena
  /// thread id is derived as `arena:{caseId}:{arenaSessionSeq}`, so a reset
  /// starts a fresh round-1 thread WITHOUT deleting prior AiInteraction rows
  /// (those stay as the permanent AI audit trail, docs/02 §6/§9).
  arenaSessionSeq Int @default(1) @map("arena_session_seq")

  // ── closing / lifecycle ──
  clientSatisfactionScore Int?    @map("client_satisfaction_score")
  referralRequested       Boolean @default(false) @map("referral_requested")
  /// Business archive (5-year retention) — DISTINCT from deletedAt soft delete.
  isArchived              Boolean @default(false) @map("is_archived")
  procEnded               Boolean @default(false) @map("proc_ended")
  procResult              String? @map("proc_result")
  /// Fixed 4-item closing checklist (prototype closingHtml), {key: boolean}.
  closingChecklist        Json?   @map("closing_checklist")

  // ── conflict-of-interest denormalized cache (docs/06 §4) ──
  /// Highest ACTIVE conflict severity; null = no active conflict. Drives the
  /// case-card ⚠ badge without recomputing detection per row.
  conflictSeverity  ConflictSeverity? @map("conflict_severity")
  conflictCheckedAt DateTime?         @map("conflict_checked_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  assignees         CaseAssignee[]
  hearings          Hearing[]
  events            CaseEvent[]
  reminders         CaseReminder[]
  tasks             Task[]
  documents         Document[]
  invoices          Invoice[]
  expenses          Expense[]
  timeEntries       TimeEntry[]
  feeAgreement      CaseFeeAgreement?
  aiInteractions    AiInteraction[]
  conflictFlags     ConflictFlag[]        @relation("ConflictCase")
  convertedFrom     Lead[]                @relation("LeadConvertedCase")
  approvals         CaseApproval[]
  execution         CaseExecution?
  procedureRequests ProcedureRequest[]
  communications    ClientCommunication[]
  messages          CaseMessage[]
  contracts         Contract[]

  @@index([officeId])
  @@index([officeId, clientId])
  @@index([officeId, deletedAt])
  @@map("cases")
}

/// Join table for the many-to-many case ⇄ user assignment (docs/03 §توصيات).
model CaseAssignee {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([caseId, userId])
  @@index([officeId])
  @@index([userId])
  @@map("case_assignees")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit (docs/02 §5, §9 — every sensitive access/decision is logged)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Actor may be null for system actions.
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id])

  action   String
  resource String?
  targetId String? @map("target_id")
  /// PERMIT | DENY — records permission decisions too (docs/04 §6).
  decision String?
  detail   String?
  meta     Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([officeId, createdAt])
  @@index([officeId, actorId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 — operational core: hearings, timeline, reminders, CRM, tasks,
// appointments, conflict flags, Najiz reference.
// ─────────────────────────────────────────────────────────────────────────

/// A single court session under a case (prototype case.hearings[]).
model Hearing {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Sequential number among HELD hearings; null while upcoming (docs BR-CASE-03).
  sequenceNo  Int?          @map("sequence_no")
  hearingDate DateTime      @map("hearing_date")
  status      HearingStatus @default(UPCOMING)
  /// Litigation stage index 0..4 (RECONCILIATION..EXECUTION); drives derived stage.
  stageIndex  Int?          @map("stage_index")
  kind        HearingKind?
  minutes     String?
  result      String?

  // Client-facing report + approval gate (published to portal in Phase 8).
  // A real request/decide workflow (prototype hrRequestReportApproval/
  // approveReportApproval/rejectReportApproval) — not a self-service toggle.
  clientReport            String?  @map("client_report")
  reportApprovalRequested Boolean  @default(false) @map("report_approval_requested")
  reportSentToClient      Boolean  @default(false) @map("report_sent_to_client")
  reportApproved          Boolean  @default(false) @map("report_approved")

  // Pending (incomplete) hearing → recurring reminder (docs BR-CASE-11).
  isPending         Boolean @default(false) @map("is_pending")
  pendingItems      Json?   @map("pending_items")
  reminderRecurDays Int?    @map("reminder_recur_days")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  reminders         CaseReminder[]
  tasks             Task[]
  procedureRequests ProcedureRequest[]

  @@index([officeId, caseId])
  @@index([officeId, hearingDate])
  @@index([officeId, status])
  @@map("hearings")
}

/// Append-only case activity log — the "timeline" (prototype logEvent/events[]).
model CaseEvent {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  type               CaseEventType
  description        String
  /// Free actor label (المحامي/الخصم/المحكمة/النظام); internal actor by FK.
  actor              String?
  actorUserId        String?       @map("actor_user_id") @db.Uuid
  /// Soft link to a procedural request, for that request's own activity log (mirrors Task.hearingId).
  procedureRequestId String?       @map("procedure_request_id") @db.Uuid
  /// Soft link to an internal approval item, for that item's own audit trail (mirrors procedureRequestId).
  approvalId         String?       @map("approval_id") @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([officeId, caseId, occurredAt])
  @@index([officeId, caseId, type])
  @@map("case_events")
}

/// Free-form dated reminder attached to a case — the custom-deadline source.
model CaseReminder {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  text              String
  dueOn             DateTime       @map("due_on")
  /// Recurrence interval in days; null = one-shot (docs BR-CAL-recurringReminder).
  recurIntervalDays Int?           @map("recur_interval_days")
  source            ReminderSource @default(MANUAL)
  isTaskLinked      Boolean        @default(false) @map("is_task_linked")

  hearingId String?  @map("hearing_id") @db.Uuid
  hearing   Hearing? @relation(fields: [hearingId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@index([officeId, dueOn])
  @@map("case_reminders")
}

/// CRM pipeline prospect (prototype LEADS). Flat table with a stage column.
model Lead {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  name          String
  type          ClientType @default(INDIVIDUAL)
  source        LeadSource @default(OTHER)
  stage         LeadStage  @default(PROSPECT)
  /// Expected deal value in halalas (integer minor units).
  expectedValue Int        @default(0) @map("expected_value")
  nextAction    String?    @map("next_action")
  phone         String?

  // Conversion provenance (set by convertLead).
  convertedClientId String? @map("converted_client_id") @db.Uuid
  convertedClient   Client? @relation("LeadConvertedClient", fields: [convertedClientId], references: [id])
  convertedCaseId   String? @map("converted_case_id") @db.Uuid
  convertedCase     Case?   @relation("LeadConvertedCase", fields: [convertedCaseId], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  conflictFlags ConflictFlag[] @relation("ConflictMatchedLead")

  @@index([officeId, stage])
  @@index([officeId])
  @@map("leads")
}

/// Kanban task (prototype TASKS).
model Task {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  title String

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  priority      TaskPriority  @default(NORMAL)
  dueAt         DateTime?     @map("due_at")
  category      TaskCategory?
  status        TaskColumn    @default(NEW)
  /// Stable ordering within a column.
  position      Int           @default(0)
  origin        TaskSource    @default(MANUAL)
  /// Idempotency key for system-generated tasks ("prep:caseId:date" / "obj:caseId:due").
  autoSignature String?       @map("auto_signature")
  completedAt   DateTime?     @map("completed_at")

  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  /// Soft link to the hearing this action item originated from (prototype
  /// hearing.actions[] kind="مهمة"), so a hearing's follow-up tasks are
  /// traceable back to it — mirrors CaseReminder.hearingId.
  hearingId String?  @map("hearing_id") @db.Uuid
  hearing   Hearing? @relation(fields: [hearingId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  // Dedupe auto-tasks per office (nullable ⇒ manual tasks are unconstrained).
  @@unique([officeId, autoSignature])
  @@index([officeId, status])
  @@index([officeId, assigneeId])
  @@index([officeId, caseId])
  @@map("tasks")
}

/// Standalone appointment (prototype APPTS) — NOT tied to a case.
model Appointment {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Denormalized contact name (may be a client or a lead).
  contactName String @map("contact_name")

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id])
  leadId   String? @map("lead_id") @db.Uuid

  scheduledOn   DateTime          @map("scheduled_on")
  scheduledTime String?           @map("scheduled_time")
  type          AppointmentType   @default(FIRST_CONSULTATION)
  status        AppointmentStatus @default(SCHEDULED)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, scheduledOn])
  @@map("appointments")
}

/// A materialized conflict-of-interest detection (docs/06 §4). Recomputed on
/// case create/edit and on reverse triggers (new client/lead). Persisted so
/// list badges are cheap and waivers are trackable + auditable.
model ConflictFlag {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation("ConflictCase", fields: [caseId], references: [id], onDelete: Cascade)

  severity      ConflictSeverity
  conflictType  ConflictType     @map("conflict_type")
  /// i18n key + params — NEVER store the Arabic literal (guardrail 6).
  messageKey    String           @map("message_key")
  messageParams Json?            @map("message_params")
  matchedName   String?          @map("matched_name")

  matchedClientId String? @map("matched_client_id") @db.Uuid
  matchedClient   Client? @relation("ConflictMatchedClient", fields: [matchedClientId], references: [id])
  matchedLeadId   String? @map("matched_lead_id") @db.Uuid
  matchedLead     Lead?   @relation("ConflictMatchedLead", fields: [matchedLeadId], references: [id])
  /// Case IDs matched in rules 3 & 4 (can be several).
  matchedCaseIds  Json?   @map("matched_case_ids")

  status     ConflictStatus @default(ACTIVE)
  waiverNote String?        @map("waiver_note")
  waivedById String?        @map("waived_by_id") @db.Uuid
  waivedBy   User?          @relation("ConflictWaivedBy", fields: [waivedById], references: [id])
  waivedAt   DateTime?      @map("waived_at")

  detectedAt DateTime @default(now()) @map("detected_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // One flag per (case, rule, matched name) — supports reconcile-on-rescan.
  @@unique([caseId, conflictType, matchedName])
  @@index([officeId, caseId])
  @@index([officeId, status])
  @@map("conflict_flags")
}

/// Najiz classification taxonomy (main → sub → leaf). Global reference data,
/// NOT tenant-scoped: the taxonomy is identical for every office. Seeded from
/// src/lib/najiz.ts.
model NajizClassification {
  id        String @id @default(uuid()) @db.Uuid
  mainClass String @map("main_class")
  subClass  String @map("sub_class")
  caseType  String @map("case_type")

  @@unique([mainClass, subClass, caseType])
  @@index([mainClass])
  @@map("najiz_classifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — documents: templates + generated/uploaded case documents.
// ─────────────────────────────────────────────────────────────────────────

/// A reusable legal-document template (prototype TEMPLATES). System templates
/// are seeded global (officeId null, isSystem) and available to every office;
/// an office may add its own. bodyTemplate holds {{placeholder}} text; fields
/// is the ordered field descriptor list (id/label/type/options/autofill/deny).
model DocumentTemplate {
  id       String  @id @default(uuid()) @db.Uuid
  officeId String? @map("office_id") @db.Uuid
  office   Office? @relation(fields: [officeId], references: [id])

  key          String
  title        String
  category     DocumentTemplateCategory
  /// Placeholder body ({{fieldId}} + the {{office}} token), rendered inside the letterhead.
  bodyTemplate String                   @map("body_template")
  /// Ordered field descriptors (Json): {id,label,type,options?,default?,autofill?,deny?}.
  fields       Json
  isSystem     Boolean                  @default(false) @map("is_system")
  isActive     Boolean                  @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  documents Document[]

  @@index([officeId])
  @@index([key])
  @@map("document_templates")
}

/// A case document — the unified document center (prototype case.docs[]). Every
/// origin (opening pack, hearing, client upload, template output, staff upload)
/// lands here, distinguished by `source`. Binary lives in object storage
/// (GCS Dammam / local dev); this row is the metadata + storage key.
model Document {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Nullable: a template doc may be generated standalone before saving to a case.
  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  fileName     String    @map("file_name")
  kind         DocKind   @default(DOCUMENT)
  source       DocSource
  party        DocParty?
  /// Free-text descriptor (صحيفة/محضر/مذكرة/مُولّد…), not an enforced enum.
  docType      String?   @map("doc_type")
  sessionLabel String?   @map("session_label")
  /// Soft link to a hearing (plain column, mirrors CaseEvent.actorUserId style).
  hearingId    String?   @map("hearing_id") @db.Uuid

  /// Link to the procedural request this attachment belongs to (prototype
  /// "📎 <file> · الطلب" / "· النتيجة"), with its role within that request.
  procedureRequestId String?                  @map("procedure_request_id") @db.Uuid
  procedureRequest   ProcedureRequest?        @relation(fields: [procedureRequestId], references: [id], onDelete: SetNull)
  procedureDocRole   ProcedureRequestDocRole? @map("procedure_doc_role")

  // ── stored object ──
  storageKey String  @map("storage_key")
  mimeType   String  @map("mime_type")
  sizeBytes  Int     @map("size_bytes")
  sha256     String?

  // ── template-generated docs ──
  templateId    String?           @map("template_id") @db.Uuid
  template      DocumentTemplate? @relation(fields: [templateId], references: [id])
  fieldValues   Json?             @map("field_values")
  renderedHtml  String?           @map("rendered_html")
  /// Frozen document date (BR-DOC-DATE-LOCALE) — re-rendering never changes it.
  generatedDate DateTime?         @map("generated_date")

  // ── text extraction (Phase-5 KB seam; produced here, indexed later) ──
  needsOcr      Boolean @default(false) @map("needs_ocr")
  extractedText String? @map("extracted_text")

  // ── client-portal sharing (Phase-8 seam) ──
  clientVisible    Boolean   @default(false) @map("client_visible")
  fromClient       Boolean   @default(false) @map("from_client")
  clientSharedAt   DateTime? @map("client_shared_at")
  clientSharedById String?   @map("client_shared_by") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@index([officeId, source])
  @@index([officeId, clientVisible])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 4 — finance: invoices, fees, expenses, time, trust, ledgers.
// All money is INTEGER HALALAS. Every write runs in a DB transaction that also
// posts a balanced journal entry. Client trust (أمانات) is a SEPARATE ledger.
// ─────────────────────────────────────────────────────────────────────────

/// Fee agreement per case (docs/06 §3). 1:1 with Case (prototype c.fee).
model CaseFeeAgreement {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @unique @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  type          FeeType @default(FLAT)
  /// FLAT lump sum / RETAINER periodic / HOURLY quoted rate — halalas. Null for PERCENTAGE.
  feeValueMinor Int?    @map("fee_value_minor")
  /// PERCENTAGE only: basis points (10% = 1000). Null otherwise.
  percentageBps Int?    @map("percentage_bps")
  /// PERCENTAGE only: court-awarded amount the percentage applies to — halalas.
  awardedMinor  Int?    @map("awarded_minor")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId])
  @@map("case_fee_agreements")
}

/// A tax invoice (فاتورة ضريبية). Effective status is DERIVED (docs/06 §7), not
/// stored; `baseStatus` only feeds the OVERDUE branch.
model Invoice {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  number String

  clientId String  @map("client_id") @db.Uuid
  client   Client  @relation(fields: [clientId], references: [id])
  caseId   String? @map("case_id") @db.Uuid
  case     Case?   @relation(fields: [caseId], references: [id])

  issueDate DateTime @map("issue_date")

  netAmount   Int @map("net_amount")
  vatAmount   Int @map("vat_amount")
  totalAmount Int @map("total_amount")

  baseStatus InvoiceBaseStatus @default(DUE) @map("base_status")
  origin     InvoiceOrigin     @default(MANUAL)
  basis      String?

  isBadDebt  Boolean @default(false) @map("is_bad_debt")
  isCredited Boolean @default(false) @map("is_credited")

  /// Provenance (plain columns, no back-relation).
  fromExpenseId   String? @map("from_expense_id") @db.Uuid
  fromTimeEntryId String? @map("from_time_entry_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  items      InvoiceItem[]
  payments   Payment[]
  creditNote CreditNote?

  @@unique([officeId, number])
  @@index([officeId, clientId])
  @@index([officeId, caseId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int    @default(1) // whole units/hours (not money)
  unitPrice   Int    @map("unit_price") // halalas
  lineNet     Int    @map("line_net") // = quantity × unitPrice (halalas)
  sortOrder   Int    @default(0) @map("sort_order")

  @@index([invoiceId])
  @@map("invoice_items")
}

/// A receipt (سند قبض) against an invoice.
model Payment {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  number String

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  paymentDate DateTime      @map("payment_date")
  amount      Int // halalas
  method      PaymentMethod
  reference   String?

  isApproved   Boolean   @default(true) @map("is_approved")
  approvedById String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")

  /// Bank reconciliation (docs/05 finBank bankToggleClear) — matched against the bank statement.
  cleared   Boolean   @default(false)
  clearedAt DateTime? @map("cleared_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@unique([officeId, number])
  @@index([officeId, invoiceId])
  @@map("payments")
}

/// A credit note (إشعار دائن) fully cancelling an invoice (never deletion).
model CreditNote {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  number String

  invoiceId String  @unique @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  clientId  String   @map("client_id") @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id])
  issueDate DateTime @map("issue_date")
  amount    Int // halalas (= invoice total)
  vatAmount Int      @map("vat_amount") // halalas (= invoice vat)
  reason    String

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@unique([officeId, number])
  @@map("credit_notes")
}

/// An office expense (prototype EXPENSES). `netAmount` is VAT-exclusive.
model Expense {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  expenseDate DateTime             @map("expense_date")
  category    ExpenseCategory      @default(OTHER)
  vendor      String?
  netAmount   Int                  @map("net_amount") // halalas (VAT-exclusive)
  inputVat    Int                  @map("input_vat") // halalas (recoverable)
  method      ExpensePaymentMethod @default(BANK_TRANSFER)
  documentNo  String?              @map("document_no")

  billable  Boolean @default(false)
  billed    Boolean @default(false)
  recurring Boolean @default(false)
  approved  Boolean @default(true)

  clientId               String? @map("client_id") @db.Uuid
  client                 Client? @relation(fields: [clientId], references: [id])
  caseId                 String? @map("case_id") @db.Uuid
  case                   Case?   @relation(fields: [caseId], references: [id])
  /// Reimbursement invoice this expense was billed into (plain column).
  reimbursementInvoiceId String? @map("reimbursement_invoice_id") @db.Uuid

  /// Bank reconciliation (docs/05 finBank bankToggleClear) — matched against the bank statement.
  cleared   Boolean   @default(false)
  clearedAt DateTime? @map("cleared_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, category])
  @@index([officeId, caseId])
  @@map("expenses")
}

/// A billable/internal time entry (prototype TIME_ENTRIES). Duration in MINUTES
/// (int) to avoid float hours; rate is halalas per hour.
model TimeEntry {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  lawyerId String @map("lawyer_id") @db.Uuid
  lawyer   User   @relation("TimeEntryLawyer", fields: [lawyerId], references: [id])
  caseId   String @map("case_id") @db.Uuid
  case     Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  description String?
  minutes     Int // duration in minutes
  hourlyRate  Int      @map("hourly_rate") // halalas per hour
  workDate    DateTime @map("work_date")
  billable    Boolean  @default(true)
  invoiced    Boolean  @default(false)
  /// Invoice this entry was billed into (plain column).
  invoiceId   String?  @map("invoice_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@index([officeId, lawyerId])
  @@map("time_entries")
}

/// Client trust (أمانات / عهدة) account — one per client. Ring-fenced client
/// money, SEPARATE from office revenue (guardrail 5). Balance is derived from
/// transactions but cached here for cheap reads + a non-negative guard.
model TrustAccount {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  clientId String @unique @map("client_id") @db.Uuid
  client   Client @relation(fields: [clientId], references: [id])

  /// Cached balance in halalas (= Σ deposits − Σ withdrawals/transfers). Never negative.
  balanceMinor Int @default(0) @map("balance_minor")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  transactions TrustTransaction[]

  @@index([officeId])
  @@map("trust_accounts")
}

/// An immutable trust movement. Never updated/deleted to change money — post a
/// compensating reverse movement instead (highest-integrity area).
model TrustTransaction {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  trustAccountId String       @map("trust_account_id") @db.Uuid
  trustAccount   TrustAccount @relation(fields: [trustAccountId], references: [id], onDelete: Cascade)

  type             TrustTxnType
  amountMinor      Int          @map("amount_minor") // halalas, always > 0
  date             DateTime
  note             String?
  /// Cross-links (plain columns).
  relatedInvoiceId String?      @map("related_invoice_id") @db.Uuid
  relatedCaseId    String?      @map("related_case_id") @db.Uuid
  journalEntryId   String?      @map("journal_entry_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  @@index([officeId, trustAccountId])
  @@map("trust_transactions")
}

/// Chart of accounts (prototype COA). Balance is DERIVED from journal lines.
model ChartOfAccount {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  code     String
  name     String
  type     AccountType
  isActive Boolean     @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  journalLines JournalLine[]

  @@unique([officeId, code])
  @@index([officeId])
  @@map("chart_of_accounts")
}

/// A balanced double-entry voucher. INVARIANT: Σ debit = Σ credit (>= 2 lines).
model JournalEntry {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  entryNo     String            @map("entry_no")
  entryDate   DateTime          @map("entry_date")
  description String
  sourceType  JournalSourceType @default(MANUAL) @map("source_type")
  sourceId    String?           @map("source_id") @db.Uuid
  periodKey   String            @map("period_key") // YYYY-MM
  postedById  String?           @map("posted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  lines JournalLine[]

  @@unique([officeId, entryNo])
  @@index([officeId, periodKey])
  @@index([officeId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String         @map("account_id") @db.Uuid
  account   ChartOfAccount @relation(fields: [accountId], references: [id])

  debit  Int     @default(0) // halalas
  credit Int     @default(0) // halalas
  lineNo Int     @map("line_no")
  memo   String?

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

/// A monthly accounting period; when locked, postings dated within it are rejected.
model AccountingPeriod {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  periodKey  String    @map("period_key") // YYYY-MM
  locked     Boolean   @default(false)
  lockedById String?   @map("locked_by") @db.Uuid
  lockedAt   DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([officeId, periodKey])
  @@map("accounting_periods")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 5 — legal AI: closed knowledge base + interaction/citation audit.
// The KnowledgeSource/Chunk corpus is GLOBAL shared reference (like Najiz);
// AiInteraction/AiCitation are tenant-scoped audit of every AI generation.
// ─────────────────────────────────────────────────────────────────────────

/// An authoritative Saudi legal source — the ONLY citable corpus (docs/02 §6).
model KnowledgeSource {
  id          String              @id @default(uuid()) @db.Uuid
  type        KnowledgeSourceType
  title       String
  /// Normalized canonical key — the deterministic match target for parsed law names.
  citationKey String              @unique @map("citation_key")
  officialRef String?             @map("official_ref")
  issuer      String?
  issueDate   DateTime?           @map("issue_date")
  /// Only active (non-repealed) sources are citable; repealed → UNMATCHED.
  isActive    Boolean             @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chunks    KnowledgeChunk[]
  citations AiCitation[]     @relation("CitationMatchedSource")

  @@index([citationKey])
  @@map("knowledge_sources")
}

/// A chunked + embedded passage of a KnowledgeSource (docs/02 §6 pgvector).
/// Embedding is stored as Float[] in dev (app-layer cosine) and swapped to a
/// pgvector `vector` column + `<=>` ANN index in production (adapter seam).
model KnowledgeChunk {
  id       String          @id @default(uuid()) @db.Uuid
  sourceId String          @map("source_id") @db.Uuid
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// The precise citable anchor within the source (مادة رقم).
  articleNumber String? @map("article_number")
  sectionRef    String? @map("section_ref")
  content       String
  /// Dev: app-layer cosine over this vector. Prod: pgvector column.
  embedding     Float[]
  ord           Int?

  createdAt DateTime @default(now()) @map("created_at")

  citations AiCitation[] @relation("CitationMatchedChunk")

  @@index([sourceId])
  @@map("knowledge_chunks")
}

/// One AI generation (assistant / case-analysis / a single arena turn). Carries
/// the gate verdict (docs/02 §6 "تُسجَّل نتيجة التحقق"). Tenant-scoped + audited.
model AiInteraction {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  surface   AiSurface
  arenaRole ArenaRole? @map("arena_role")
  /// Groups a chat/arena session (plain column).
  threadId  String?    @map("thread_id")

  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id])

  question          String
  /// KnowledgeChunk ids the generator was constrained to (Json string array).
  retrievedChunkIds Json        @map("retrieved_chunk_ids")
  /// Model output BEFORE the gate (retained for audit/diffing).
  rawDraft          String      @map("raw_draft")
  /// Post-gate text actually shown (unmatched citations stripped).
  finalOutput       String      @map("final_output")
  verdict           GateVerdict
  groundingNote     String?     @map("grounding_note")
  disclaimerShown   Boolean     @default(true) @map("disclaimer_shown")
  model             String?

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  citations AiCitation[]

  @@index([officeId, caseId])
  @@index([officeId, surface])
  @@map("ai_interactions")
}

/// One citation extracted from a generation + its verification outcome — the
/// granular gate record (docs/02 §6: each citation matched to a real source).
model AiCitation {
  id            String        @id @default(uuid()) @db.Uuid
  interactionId String        @map("interaction_id") @db.Uuid
  interaction   AiInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  rawText             String       @map("raw_text")
  type                CitationType
  parsedLawName       String?      @map("parsed_law_name")
  parsedArticleNumber String?      @map("parsed_article_number")

  matchedSourceId String?          @map("matched_source_id") @db.Uuid
  matchedSource   KnowledgeSource? @relation("CitationMatchedSource", fields: [matchedSourceId], references: [id])
  matchedChunkId  String?          @map("matched_chunk_id") @db.Uuid
  matchedChunk    KnowledgeChunk?  @relation("CitationMatchedChunk", fields: [matchedChunkId], references: [id])

  matchStatus CitationMatchStatus @map("match_status")
  action      CitationAction

  createdAt DateTime @default(now()) @map("created_at")

  @@index([interactionId])
  @@map("ai_citations")
}

// ─────────────────────────────────────────────────────────────────────────
// HR (Phase 6) — payroll, advances, leaves, requests, Saudization, WPS
// ─────────────────────────────────────────────────────────────────────────

/// An employee of the office (prototype EMPLOYEES + EMP_EXTRA, folded in).
/// Money fields are integer halalas. Nationality + hireDate feed end-of-service
/// (docs/06 §5) and Saudization (docs/06 §6). Optionally linked to a login User
/// for the employee portal.
model Employee {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Optional link to a login account (portal identity). One user ⇢ one employee.
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation("EmployeeUser", fields: [userId], references: [id])

  name        String
  /// E.164 phone for بوابة الموظف (employee self-service portal) OTP login —
  /// distinct from User.phone, which only exists once a system account is
  /// explicitly granted (docs/04: employees have no system role by default).
  phone       String?
  department  String?        @map("department")
  jobTitle    String?        @map("job_title")
  nationality String         @default("سعودي") // EMP_EXTRA.nat — isSaudi() compares to this
  nationalId  String?        @map("national_id") // هوية/إقامة — used for WPS
  iban        String? // used for WPS wage file
  hireDate    DateTime       @map("hire_date") // EMP_EXTRA.joinY derives from this
  status      EmployeeStatus @default(ACTIVE)

  basicSalary      Int  @map("basic_salary") // halalas
  allowances       Int  @default(0) // halalas
  gosiContribution Int  @default(0) @map("gosi_contribution") // employee GOSI deduction, halalas
  leaveBalanceDays Int  @default(0) @map("leave_balance_days") // remaining annual-leave days
  performanceScore Int? @map("performance_score") // 0–100 (PERF_LOG feeds نبض الفريق)

  terminatedAt      DateTime? @map("terminated_at")
  endOfServiceMinor Int?      @map("end_of_service_minor") // computed EOS award, halalas

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  advances     Advance[]
  leaves       Leave[]
  attendance   Attendance[]
  requests     EmployeeRequest[]
  payrollLines PayrollLine[]

  @@index([officeId, status])
  @@index([officeId, nationality])
  @@map("employees")
}

/// A salary advance/loan to an employee (prototype ADVANCES). Repaid by monthly
/// deductions inside the payroll run (docs/06 §8). Amounts are halalas.
model Advance {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  amount             Int // total advance, halalas
  monthlyInstallment Int?          @map("monthly_installment") // explicit installment, halalas; else derived
  months             Int           @default(1) // number of installments (>=1)
  paid               Int           @default(0) // repaid so far, halalas
  advanceDate        DateTime      @map("advance_date")
  status             AdvanceStatus @default(ACTIVE)
  note               String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, employeeId])
  @@index([officeId, status])
  @@map("advances")
}

/// A recorded leave (prototype LEAVES). ANNUAL leave draws down leaveBalanceDays.
model Leave {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  type            LeaveType @default(ANNUAL)
  days            Int
  startDate       DateTime  @map("start_date")
  note            String?
  /// Whether this leave drew down the balance (true only for ANNUAL) — recorded
  /// so balance restoration on soft-delete is exact.
  deductedBalance Boolean   @default(false) @map("deducted_balance")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, employeeId])
  @@map("leaves")
}

enum IntegrationKey {
  GOSI // التأمينات الاجتماعية
  QIWA // منصة قوى
  MUDAD // مدد (WPS)
  ZATCA // هيئة الزكاة والضريبة
  ABSHER // أبشر أعمال
  MUQEEM // مقيم
}

/// التكاملات (docs/03 `INTEGRATIONS`) — "محاكاة بصرية، بلا ربط API فعلي"
/// per docs itself: a real per-office connect/disconnect/sync-now toggle,
/// honestly presented as simulated status (no actual government API calls).
/// Starts disconnected for every office — never seeded as pre-connected,
/// since that would misrepresent a fresh office's real state.
model IntegrationConnection {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  key          IntegrationKey
  connected    Boolean   @default(false)
  lastSyncedAt DateTime? @map("last_synced_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([officeId, key])
  @@map("integration_connections")
}

enum CandidateStage {
  APPLIED // متقدّم
  INTERVIEW // مقابلة
  OFFER // عرض وظيفي
  HIRED // تعيين
}

/// التوظيف (docs/03 `RECRUIT`): job candidates, mirroring the Lead pipeline's
/// shape and move semantics. Reaching HIRED is just the pipeline's terminal
/// stage — creating the actual Employee record stays a separate, explicit
/// action on the Employees tab (a hire needs salary/hireDate/department a
/// candidate record doesn't carry), same way a CONTRACTED lead still needs
/// an explicit convert step to become a Client + Case.
model Candidate {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  name     String
  roleTitle String? @map("role_title")
  source   LeadSource @default(OTHER)
  stage    CandidateStage @default(APPLIED)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, stage])
  @@map("candidates")
}

enum AttendanceStatus {
  PRESENT // حاضر
  LATE // متأخر
  ABSENT // غائب
  LEAVE // إجازة
}

/// Daily attendance (docs/05 hrAtt, docs/01 "الموارد البشرية الكاملة").
/// One row per (employee, day); the monthly summary is aggregated live from
/// these rows, not stored separately. No absence/lateness deduction formula
/// is documented in docs/06, so this deliberately stops at raw day counts —
/// feeding a halalas figure into payroll would mean inventing a business
/// rule, not implementing one.
model Attendance {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  /// Calendar day, time-of-day zeroed — one record per employee per day.
  date     DateTime
  status   AttendanceStatus @default(PRESENT)
  checkIn  DateTime?        @map("check_in")
  checkOut DateTime?        @map("check_out")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@unique([officeId, employeeId, date])
  @@index([officeId, date])
  @@map("attendance")
}

/// A self-service employee request (prototype EMP_REQUESTS): leave, advance,
/// certificate, etc. `history` is an append-only JSON audit of stage changes.
model EmployeeRequest {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  department String?
  kind       RequestKind
  detail     String?
  days       Int?
  status     RequestStatus @default(SUBMITTED)
  history    Json          @default("[]") // [{status, by, at, note}]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, employeeId])
  @@index([officeId, status])
  @@map("employee_requests")
}

/// A monthly payroll run (prototype PAYROLL_RUNS). One per (office, period).
/// When POSTED it holds a balanced journal entry and is immutable. Totals are
/// halalas; per-employee detail lives in PayrollLine.
model PayrollRun {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  periodKey String           @map("period_key") // YYYY-MM
  status    PayrollRunStatus @default(POSTED)

  totalBasic      Int @default(0) @map("total_basic")
  totalAllowances Int @default(0) @map("total_allowances")
  totalGosi       Int @default(0) @map("total_gosi")
  totalAdvances   Int @default(0) @map("total_advances") // advance deductions applied
  totalNet        Int @default(0) @map("total_net")

  journalEntryId String? @map("journal_entry_id") @db.Uuid
  postedById     String? @map("posted_by") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  lines PayrollLine[]

  @@unique([officeId, periodKey])
  @@map("payroll_runs")
}

/// One employee's line in a payroll run. net = basic + allowances − gosi −
/// advanceDeduction (docs/06 §8, data-model PAYROLL_RUNS). All halalas.
model PayrollLine {
  id           String     @id @default(uuid()) @db.Uuid
  payrollRunId String     @map("payroll_run_id") @db.Uuid
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  basic            Int
  allowances       Int
  gosi             Int
  advanceDeduction Int @map("advance_deduction")
  net              Int

  createdAt DateTime @default(now()) @map("created_at")

  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_lines")
}

// ---------- Pulse (نبض الفريق): performance points feeding "Employee of the
// Week" (prototype eowCard). Fixed point values per kind, computed in
// src/lib/performance.ts — this table is just the ledger.
enum PerformanceEventKind {
  TASK_COMPLETED // إنجاز مهمة
  HEARING_RECORDED // تسجيل جلسة
  DOCUMENT_GENERATED // توليد مستند
  INVOICE_CREATED // إنشاء فاتورة
  LEAD_CONVERTED // تحويل عميل محتمل
}

model PerformanceEvent {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  kind   PerformanceEventKind
  points Int

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([officeId, userId, occurredAt])
  @@map("performance_events")
}

// ---------- Internal review pipeline (الاعتمادات), per case. A fixed 5-stage
// review a case document/deliverable moves through before it's considered
// approved (prototype: "مسودة ← محامٍ أول ← مستشار ← تدقيق لغوي ← اعتماد
// الشريك ← معتمد"). Distinct from the client-report approval gate (Phase 8)
// and from HR's EmployeeRequest workflow — this is purely internal review.
enum ApprovalStage {
  DRAFT // مسودة
  SENIOR_LAWYER // محامٍ أول
  COUNSEL // مستشار
  PROOFREADING // تدقيق لغوي
  PARTNER // اعتماد الشريك
  APPROVED // معتمد
}

model CaseApproval {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  title String
  stage ApprovalStage @default(DRAFT)

  /// If set, reaching APPROVED auto-decides that hearing's pending client-report
  /// approval request (prototype apprAdvance → hrDoSendReport). Plain soft link,
  /// mirrors Document.hearingId.
  hearingId String? @map("hearing_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@map("case_approvals")
}

// ---------- Procedural requests/milestones (طلبات ومعالم) filed within a
// procedural stage (prototype "تفاصيل الطلبات والمعالم") — e.g. a motion to
// appoint an expert, an objection/appeal, a cassation petition. Distinct from
// Hearing (a court session) and CaseApproval (internal review workflow).
enum ProcedureRequestStatus {
  SUBMITTED // مُقدّم
  PENDING // قيد النظر
  ACCEPTED // مقبول
  REJECTED // مرفوض
}

/// Which half of a procedural request an attached document represents
/// (prototype "📎 <file> · الطلب" vs "· النتيجة").
enum ProcedureRequestDocRole {
  REQUEST // الطلب
  RESULT // النتيجة
}

model ProcedureRequest {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// The hearing this request was raised/decided in, if logged from there (docs BR-CASE-11b).
  hearingId String?  @map("hearing_id") @db.Uuid
  hearing   Hearing? @relation(fields: [hearingId], references: [id], onDelete: SetNull)

  // 0..4 = RECONCILIATION..EXECUTION (matches STAGE_BY_INDEX in cases.ts).
  stageIndex Int @map("stage_index")

  /// Which side filed the request (prototype "↗ الخصم" / "↗ نحن").
  party  DocParty
  /// Free-text descriptor from a closed vocabulary (PROC_REQUEST_TYPES), not an enforced enum — mirrors Document.docType.
  type   String?
  text   String
  status ProcedureRequestStatus @default(SUBMITTED)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  documents Document[]

  @@index([officeId, caseId])
  @@map("procedure_requests")
}

// ---------- Client communication log (سجل التواصل مع العميل), prototype
// commsAdd() — a running log of client contact touchpoints on the Parties
// tab, distinct from any live chat/portal messaging (that's Phase 8).
enum ClientCommunicationType {
  CALL // مكالمة
  MESSAGE // رسالة
  MEETING // اجتماع
  EMAIL // بريد إلكتروني
}

model ClientCommunication {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  type ClientCommunicationType
  note String

  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@map("client_communications")
}

// ---------- Case chat (محادثة العميل) — a direct message thread between
// office staff and the client on one case, distinct from the internal
// CaseEvent timeline and from ClientCommunication (a manually logged touchpoint
// note, not a live conversation). Client-side sending is authenticated via the
// separate client-portal session (Phase 8), not the staff AppSession.
enum MessageSenderType {
  STAFF // المكتب
  CLIENT // العميل
}

model CaseMessage {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  senderType   MessageSenderType @map("sender_type")
  /// Staff sender (plain soft link, mirrors CaseEvent.actorUserId) — null when senderType = CLIENT.
  senderUserId String?           @map("sender_user_id") @db.Uuid
  body         String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([officeId, caseId, createdAt])
  @@map("case_messages")
}

// ---------- Case contracts list (عقود القضية), prototype wsAddContract() —
// a simple named, signable/unsigned document tracker per case (e.g. عقد
// الأتعاب / الوكالة الشرعية / اتفاقية السرية). NOT documented in docs/01–06;
// built as a plain new entity rather than repurposing CaseFeeAgreement or the
// POA-expiry deadline field, since both of those already have their own
// distinct, more structured tracking (Finance tab / deadlines) that a generic
// signable-list model would not improve.
model Contract {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  title    String
  isSigned Boolean   @default(false) @map("is_signed")
  signedAt DateTime? @map("signed_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@map("contracts")
}

// ---------- Post-judgment execution/enforcement file (تنفيذ), one per case
// once opened. Distinct from the litigation Hearing/ProcStage flow — this
// tracks the enforcement request against a debtor after judgment.
enum ExecutionFileStatus {
  ACTIVE // نشط
  PARTIALLY_COLLECTED // محصّل جزئياً
  FULLY_COLLECTED // محصّل بالكامل
  STALLED // متعثّر
  CLOSED // مغلق
}

enum ExecutionProcStatus {
  REQUIRED // مطلوب
  IN_PROGRESS // قيد التنفيذ
  EXECUTED // منفّذ
  STALLED // متعثّر
}

model CaseExecution {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @unique @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  court          String?
  requestNo      String?             @map("request_no")
  amountMinor    Int?                @map("amount_minor")
  collectedMinor Int                 @default(0) @map("collected_minor")
  debtor         String?
  basis          String?
  openedAt       DateTime?           @map("opened_at")
  status         ExecutionFileStatus @default(ACTIVE)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  procedures ExecutionProcedure[]

  @@map("case_executions")
}

model ExecutionProcedure {
  id              String        @id @default(uuid()) @db.Uuid
  caseExecutionId String        @map("case_execution_id") @db.Uuid
  caseExecution   CaseExecution @relation(fields: [caseExecutionId], references: [id], onDelete: Cascade)

  type   String
  status ExecutionProcStatus @default(REQUIRED)
  note   String?
  /// Which side carried out the step (prototype execAddProc party field).
  party  DocParty?
  /// The step's actual/backdatable date, distinct from createdAt (prototype exPDate).
  date   DateTime?

  /// Follow-up date + assignee (prototype execSyncFollowReminder/execSyncFollowTask):
  /// set at creation time, auto-generates a linked CaseReminder (see reminderId).
  followUpDate       DateTime? @map("follow_up_date")
  followUpAssigneeId String?   @map("follow_up_assignee_id") @db.Uuid
  /// The auto-created reminder for followUpDate, plain soft link (mirrors Document.hearingId).
  reminderId         String?   @map("reminder_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([caseExecutionId])
  @@map("execution_procedures")
}
