// Murafaa — Prisma schema (single source of truth for the DB).
// Phase 1 (foundation): tenancy, users, auth/OTP, RBAC (3 layers),
// core case/client entities, and the audit log.
//
// Invariants enforced across EVERY business table (docs/02 §4, CLAUDE.md):
//   - id          UUID primary key
//   - officeId    tenant scope — present from day one (owner decision 2026-07-05)
//   - createdAt / updatedAt / createdById  audit columns
//   - deletedAt   soft delete (recycle bin)
// Money is stored as integer minor units (halalas), never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Phase 5 adds the pgvector extension here (AI knowledge base); not needed yet.
}

// ─────────────────────────────────────────────────────────────────────────
// Enums (stable procedural vocabulary — docs/06 §10)
// ─────────────────────────────────────────────────────────────────────────

/// The six office-portal roles (docs/04). Stored as an enum; the editable
/// permission *matrix* lives in the Permission table, not here.
enum Role {
  PARTNER // شريك — full access, replaces prototype "god mode"
  LAWYER // محامي
  ASSISTANT // مساعد
  ACCOUNTANT // محاسب
  ADMIN // إداري
  RECEPTION // موظف استقبال
}

/// The 13 permission-controlled modules (docs/04).
enum PermModule {
  CASES
  AI
  CLIENTS
  DOCUMENTS
  FINANCE
  HR
  REPORTS
  PERMISSIONS
  WHATSAPP
  APPOINTMENTS
  TASKS
  ALERTS
  PULSE
}

/// Permission levels: none < view < edit < full (docs/04).
enum PermLevel {
  NONE
  VIEW
  EDIT
  FULL
}

/// Row-level case visibility scope per role (docs/04 layer 3).
enum CaseScope {
  ALL
  ASSIGNED
}

enum ClientType {
  INDIVIDUAL // فرد
  COMPANY // شركة
  ESTABLISHMENT // مؤسسة
}

/// Client lifecycle status (prototype CLIENTS.st). Distinct from the Lead pipeline.
enum ClientStatus {
  ACTIVE // نشط
  PROSPECT // محتمل
  INACTIVE // متوقف
}

/// Our client's litigation capacity in a case (prototype case.role).
enum PartyRole {
  PLAINTIFF // مدّعٍ
  DEFENDANT // مدّعى عليه
}

/// Hearing lifecycle (prototype hearing.status).
enum HearingStatus {
  UPCOMING // قادمة
  HELD // منعقدة
}

/// Hearing kinds (docs/06 §10 HEARING_KINDS, 10 values).
enum HearingKind {
  PRELIMINARY // تمهيدية
  PLEADING // مرافعة
  MEMO_EXCHANGE // تبادل مذكرات
  PROCEDURAL_CONTROL // ضبط/إجراءات
  WITNESS_HEARING // سماع شهود
  EXPERT_EXAMINATION // خبرة
  RESERVED_FOR_JUDGMENT // حجز للحكم
  JUDGMENT_PRONOUNCEMENT // نطق بالحكم
  RECONCILIATION // صلح
  OTHER // أخرى
}

/// Case timeline event types (prototype EV_META).
enum CaseEventType {
  STAGE // المرحلة
  REQUEST // طلب إجرائي
  DOC // مستند
  APPROVAL // اعتماد
  OPENING // افتتاحي
  DEADLINE // موعد/مهلة
  MESSAGE // رسالة
  SYSTEM // نظام
}

/// CRM pipeline stage (prototype LEADS keys / STAGES).
enum LeadStage {
  PROSPECT // عميل محتمل
  FIRST_CONSULTATION // استشارة أولى
  FEE_PROPOSAL_SENT // عرض أتعاب مُرسل
  CONTRACTED // متعاقد
}

/// Where a lead originated (prototype leadSrc + waToLead).
enum LeadSource {
  REFERRAL // إحالة
  WEBSITE // الموقع
  LINKEDIN // لينكدإن
  PHONE_CALL // اتصال
  EXHIBITION // معرض
  WHATSAPP // واتساب
  OTHER // أخرى
}

/// Kanban column = task status (docs/06 §10 TASK_COLS).
enum TaskColumn {
  NEW // جديد
  IN_PROGRESS // قيد التنفيذ
  DONE // منجز
}

enum TaskPriority {
  URGENT // عاجل
  NORMAL // عادي
}

/// Task categories (prototype TASK_CATS) — carry point weights in Pulse (Phase 6).
enum TaskCategory {
  CONTRACT_SIGNING // توقيع عقد
  MEMO_DRAFTING // إعداد مذكرة
  CONTRACT_DOC_REVIEW // مراجعة عقد/مستند
  LEGAL_RESEARCH // بحث قانوني
  PROCEDURAL_FOLLOWUP // متابعة إجرائية
  CLIENT_CORRESPONDENCE // مراسلة عميل
  GENERAL // مهمة عامة
}

/// How a task was created (for audit/filtering).
enum TaskSource {
  MANUAL
  AUTO_HEARING_PREP
  AUTO_OBJECTION
  HEARING_ACTION
}

/// Standalone appointment type (prototype apptType).
enum AppointmentType {
  FIRST_CONSULTATION // استشارة أولى
  CONTRACT_REVIEW // مراجعة عقد
  FOLLOW_UP // متابعة
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  DONE
}

/// Conflict-of-interest severity (docs/06 §4).
enum ConflictSeverity {
  HIGH // مرتفع
  MEDIUM // متوسط
}

/// Which of the four conflict rules fired (docs/06 §4).
enum ConflictType {
  OPPONENT_IS_CLIENT // الخصم عميل حالي
  OPPONENT_IS_LEAD // الخصم عميل محتمل
  OPPONENT_IS_OUR_CLIENT_OTHER_CASE // الخصم موكّلنا في قضية أخرى
  OUR_CLIENT_IS_OPPONENT_OTHER_CASE // موكّلنا خصم في قضية أخرى
}

enum ConflictStatus {
  ACTIVE // نشط
  WAIVED // موافقة/تنازل موثّق
  RESOLVED // منتهٍ
}

/// Origin of a case reminder (prototype reminder.from).
enum ReminderSource {
  MANUAL
  PENDING_HEARING // جلسة معلّقة
  HEARING_MINUTES // محضر الجلسة
  EXECUTION_FOLLOWUP // التنفيذ
}

/// Media/form shape of a document (prototype doc.kind → kindIconG).
enum DocKind {
  DOCUMENT // مستند (PDF/office file)
  IMAGE // صورة (needs OCR)
  TEXT // نص
  FILE // ملف (generic)
  LETTER // خطاب (generated letter/report)
}

/// Where a document came from (prototype doc.source).
enum DocSource {
  OPENING // افتتاحي — opening pack
  PROCEDURAL_REQUEST // طلب — procedural-request attachment
  HEARING // جلسة — hearing worksheet/attachment
  CLIENT // عميل — client-portal upload
  TEMPLATE // قالب — generated from a template
  UPLOAD // رفع — staff upload
}

/// Which side a document belongs to (prototype doc.party).
enum DocParty {
  OURS // نحن
  OPPONENT // الخصم
  COURT // المحكمة
}

/// Template category (prototype template.c) — groups the picker.
enum DocumentTemplateCategory {
  CLAIMS // دعاوى
  MEMOS // مذكرات
  CONTRACTS // عقود
  POWERS_OF_ATTORNEY // وكالات
  ADMIN // إدارية
  EXECUTION // تنفيذ
}

/// Litigation stages (docs/06 §10 PROC_STAGES).
enum ProcStage {
  RECONCILIATION // الصلح
  FIRST_INSTANCE // الدرجة الأولى
  APPEAL // الاستئناف
  CASSATION // النقض
  EXECUTION // التنفيذ
}

enum CaseStatus {
  ACTIVE // جارية
  SUSPENDED // متوقفة
  CLOSED // مغلقة
}

/// Case outcome (docs/06 §10) — feeds the win-rate KPI.
enum CaseOutcome {
  WON // كسب
  PARTIAL // جزئي
  SETTLED // تسوية
  LOST // خسارة
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

/// A law office = one tenant. Every business row hangs off an Office.
model Office {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  /// Letterhead / branding used by all generated PDFs (name, tagline, contact,
  /// license, colors, confidentiality notice, logo key). Null → code defaults.
  branding  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users             User[]
  clients           Client[]
  cases             Case[]
  leads             Lead[]
  tasks             Task[]
  appointments      Appointment[]
  hearings          Hearing[]
  caseEvents        CaseEvent[]
  caseReminders     CaseReminder[]
  conflictFlags     ConflictFlag[]
  documents         Document[]
  documentTemplates DocumentTemplate[]
  permissions       Permission[]
  fieldDenies       FieldPermission[]
  caseScopes        RoleCaseScope[]
  auditLogs         AuditLog[]
  otps              OtpChallenge[]

  @@map("offices")
}

// ─────────────────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  name     String
  /// E.164 phone, unique per office (OTP login identifier).
  phone    String
  role     Role
  /// Owner is modeled as PARTNER — there is no implicit god mode.
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  assignedCases   CaseAssignee[]
  auditLogs       AuditLog[]
  tasks           Task[]         @relation("TaskAssignee")
  waivedConflicts ConflictFlag[] @relation("ConflictWaivedBy")

  @@unique([officeId, phone])
  @@index([officeId])
  @@map("users")
}

/// One-time password challenge for phone/WhatsApp login (docs/02 §8).
/// The code is stored hashed; the row is short-lived and attempt-limited.
model OtpChallenge {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([officeId, phone])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ─────────────────────────────────────────────────────────────────────────
// RBAC — the editable matrix (docs/04). Enforced server-side, all 3 layers.
// ─────────────────────────────────────────────────────────────────────────

/// Layer 1: module access. (office, role, module) → level.
model Permission {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  role   Role
  module PermModule
  level  PermLevel

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([officeId, role, module])
  @@index([officeId])
  @@map("permissions")
}

/// Layer 2: field denial. (office, role, resource, field) is denied.
/// Seeded example: ASSISTANT is denied the "fees" field on cases.
model FieldPermission {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  role     Role
  resource String
  field    String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([officeId, role, resource, field])
  @@index([officeId])
  @@map("field_permissions")
}

/// Layer 3: row scope for cases. (office, role) → ALL | ASSIGNED.
model RoleCaseScope {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  role  Role
  scope CaseScope

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([officeId, role])
  @@index([officeId])
  @@map("role_case_scopes")
}

// ─────────────────────────────────────────────────────────────────────────
// Core domain (minimal for Phase 1 — expanded in Phase 2)
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id       String @id @default(uuid()) @map("id") @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  name   String
  phone  String?
  city   String?
  type   ClientType   @default(INDIVIDUAL)
  status ClientStatus @default(ACTIVE)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  cases         Case[]
  appointments  Appointment[]
  convertedFrom Lead[]         @relation("LeadConvertedClient")
  conflictFlags ConflictFlag[] @relation("ConflictMatchedClient")

  // phone is the client-portal login key; unique per office when present
  // (Postgres allows multiple NULLs, so phone-less clients are fine).
  @@unique([officeId, phone])
  @@index([officeId])
  @@map("clients")
}

model Case {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Display number (e.g. "1445/...").
  number String
  title  String

  /// Our client's litigation capacity (prototype case.role).
  clientRole PartyRole @default(PLAINTIFF) @map("client_role")

  /// Our client (FK, replacing the prototype's name-string link).
  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id])

  /// Opposing party — the axis of conflict-of-interest detection (docs/06 §4).
  /// Free text (no FK): the opponent is not necessarily in our system.
  opposingParty String? @map("opposing_party")

  /// Najiz classification (main → sub → leaf). Stored as strings validated
  /// against the NajizClassification reference table.
  najizMainClass String? @map("najiz_main_class")
  najizSubClass  String? @map("najiz_sub_class")
  najizCaseType  String? @map("najiz_case_type")

  city String?

  /// Baseline procedural stage. The EFFECTIVE stage is derived from the latest
  /// held hearing (see cases service stageOf); this is the manual floor.
  stage   ProcStage    @default(FIRST_INSTANCE)
  status  CaseStatus   @default(ACTIVE)
  outcome CaseOutcome?

  /// Lawyer-authored fact summary (fed into AI context in Phase 5).
  factSummary String? @map("fact_summary")

  /// Judgment pronouncement date — the source for the objection deadline.
  judgmentDate DateTime? @map("judgment_date")

  /// Objection deadline = judgment date + 30 days (docs/06 §1). Nullable until
  /// judgment is recorded; computed by the service layer, never the UI.
  objectionDueAt DateTime? @map("objection_due_at")

  /// Power-of-attorney (الوكالة الشرعية) expiry — surfaced as a deadline.
  poaExpiresAt DateTime? @map("poa_expires_at")

  // ── closing / lifecycle ──
  clientSatisfactionScore Int?    @map("client_satisfaction_score")
  referralRequested       Boolean @default(false) @map("referral_requested")
  /// Business archive (5-year retention) — DISTINCT from deletedAt soft delete.
  isArchived              Boolean @default(false) @map("is_archived")
  procEnded               Boolean @default(false) @map("proc_ended")
  procResult              String? @map("proc_result")

  // ── conflict-of-interest denormalized cache (docs/06 §4) ──
  /// Highest ACTIVE conflict severity; null = no active conflict. Drives the
  /// case-card ⚠ badge without recomputing detection per row.
  conflictSeverity  ConflictSeverity? @map("conflict_severity")
  conflictCheckedAt DateTime?         @map("conflict_checked_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  assignees     CaseAssignee[]
  hearings      Hearing[]
  events        CaseEvent[]
  reminders     CaseReminder[]
  tasks         Task[]
  documents     Document[]
  conflictFlags ConflictFlag[] @relation("ConflictCase")
  convertedFrom Lead[]         @relation("LeadConvertedCase")

  @@index([officeId])
  @@index([officeId, clientId])
  @@index([officeId, deletedAt])
  @@map("cases")
}

/// Join table for the many-to-many case ⇄ user assignment (docs/03 §توصيات).
model CaseAssignee {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([caseId, userId])
  @@index([officeId])
  @@index([userId])
  @@map("case_assignees")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit (docs/02 §5, §9 — every sensitive access/decision is logged)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Actor may be null for system actions.
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id])

  action   String
  resource String?
  targetId String? @map("target_id")
  /// PERMIT | DENY — records permission decisions too (docs/04 §6).
  decision String?
  detail   String?
  meta     Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([officeId, createdAt])
  @@index([officeId, actorId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 — operational core: hearings, timeline, reminders, CRM, tasks,
// appointments, conflict flags, Najiz reference.
// ─────────────────────────────────────────────────────────────────────────

/// A single court session under a case (prototype case.hearings[]).
model Hearing {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Sequential number among HELD hearings; null while upcoming (docs BR-CASE-03).
  sequenceNo  Int?          @map("sequence_no")
  hearingDate DateTime      @map("hearing_date")
  status      HearingStatus @default(UPCOMING)
  /// Litigation stage index 0..4 (RECONCILIATION..EXECUTION); drives derived stage.
  stageIndex  Int?          @map("stage_index")
  kind        HearingKind?
  minutes     String?
  result      String?

  // Client-facing report + approval gate (published to portal in Phase 8).
  clientReport       String? @map("client_report")
  reportSentToClient Boolean @default(false) @map("report_sent_to_client")
  reportApproved     Boolean @default(false) @map("report_approved")

  // Pending (incomplete) hearing → recurring reminder (docs BR-CASE-11).
  isPending         Boolean @default(false) @map("is_pending")
  pendingItems      Json?   @map("pending_items")
  reminderRecurDays Int?    @map("reminder_recur_days")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  reminders CaseReminder[]

  @@index([officeId, caseId])
  @@index([officeId, hearingDate])
  @@index([officeId, status])
  @@map("hearings")
}

/// Append-only case activity log — the "timeline" (prototype logEvent/events[]).
model CaseEvent {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  type        CaseEventType
  description String
  /// Free actor label (المحامي/الخصم/المحكمة/النظام); internal actor by FK.
  actor       String?
  actorUserId String?       @map("actor_user_id") @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([officeId, caseId, occurredAt])
  @@index([officeId, caseId, type])
  @@map("case_events")
}

/// Free-form dated reminder attached to a case — the custom-deadline source.
model CaseReminder {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  text              String
  dueOn             DateTime       @map("due_on")
  /// Recurrence interval in days; null = one-shot (docs BR-CAL-recurringReminder).
  recurIntervalDays Int?           @map("recur_interval_days")
  source            ReminderSource @default(MANUAL)
  isTaskLinked      Boolean        @default(false) @map("is_task_linked")

  hearingId String?  @map("hearing_id") @db.Uuid
  hearing   Hearing? @relation(fields: [hearingId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@index([officeId, dueOn])
  @@map("case_reminders")
}

/// CRM pipeline prospect (prototype LEADS). Flat table with a stage column.
model Lead {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  name          String
  type          ClientType @default(INDIVIDUAL)
  source        LeadSource @default(OTHER)
  stage         LeadStage  @default(PROSPECT)
  /// Expected deal value in halalas (integer minor units).
  expectedValue Int        @default(0) @map("expected_value")
  nextAction    String?    @map("next_action")
  phone         String?

  // Conversion provenance (set by convertLead).
  convertedClientId String? @map("converted_client_id") @db.Uuid
  convertedClient   Client? @relation("LeadConvertedClient", fields: [convertedClientId], references: [id])
  convertedCaseId   String? @map("converted_case_id") @db.Uuid
  convertedCase     Case?   @relation("LeadConvertedCase", fields: [convertedCaseId], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  conflictFlags ConflictFlag[] @relation("ConflictMatchedLead")

  @@index([officeId, stage])
  @@index([officeId])
  @@map("leads")
}

/// Kanban task (prototype TASKS).
model Task {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  title String

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  priority      TaskPriority  @default(NORMAL)
  dueAt         DateTime?     @map("due_at")
  category      TaskCategory?
  status        TaskColumn    @default(NEW)
  /// Stable ordering within a column.
  position      Int           @default(0)
  origin        TaskSource    @default(MANUAL)
  /// Idempotency key for system-generated tasks ("prep:caseId:date" / "obj:caseId:due").
  autoSignature String?       @map("auto_signature")
  completedAt   DateTime?     @map("completed_at")

  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  // Dedupe auto-tasks per office (nullable ⇒ manual tasks are unconstrained).
  @@unique([officeId, autoSignature])
  @@index([officeId, status])
  @@index([officeId, assigneeId])
  @@index([officeId, caseId])
  @@map("tasks")
}

/// Standalone appointment (prototype APPTS) — NOT tied to a case.
model Appointment {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Denormalized contact name (may be a client or a lead).
  contactName String @map("contact_name")

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id])
  leadId   String? @map("lead_id") @db.Uuid

  scheduledOn   DateTime          @map("scheduled_on")
  scheduledTime String?           @map("scheduled_time")
  type          AppointmentType   @default(FIRST_CONSULTATION)
  status        AppointmentStatus @default(SCHEDULED)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, scheduledOn])
  @@map("appointments")
}

/// A materialized conflict-of-interest detection (docs/06 §4). Recomputed on
/// case create/edit and on reverse triggers (new client/lead). Persisted so
/// list badges are cheap and waivers are trackable + auditable.
model ConflictFlag {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  caseId String @map("case_id") @db.Uuid
  case   Case   @relation("ConflictCase", fields: [caseId], references: [id], onDelete: Cascade)

  severity      ConflictSeverity
  conflictType  ConflictType     @map("conflict_type")
  /// i18n key + params — NEVER store the Arabic literal (guardrail 6).
  messageKey    String           @map("message_key")
  messageParams Json?            @map("message_params")
  matchedName   String?          @map("matched_name")

  matchedClientId String? @map("matched_client_id") @db.Uuid
  matchedClient   Client? @relation("ConflictMatchedClient", fields: [matchedClientId], references: [id])
  matchedLeadId   String? @map("matched_lead_id") @db.Uuid
  matchedLead     Lead?   @relation("ConflictMatchedLead", fields: [matchedLeadId], references: [id])
  /// Case IDs matched in rules 3 & 4 (can be several).
  matchedCaseIds  Json?   @map("matched_case_ids")

  status     ConflictStatus @default(ACTIVE)
  waiverNote String?        @map("waiver_note")
  waivedById String?        @map("waived_by_id") @db.Uuid
  waivedBy   User?          @relation("ConflictWaivedBy", fields: [waivedById], references: [id])
  waivedAt   DateTime?      @map("waived_at")

  detectedAt DateTime @default(now()) @map("detected_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // One flag per (case, rule, matched name) — supports reconcile-on-rescan.
  @@unique([caseId, conflictType, matchedName])
  @@index([officeId, caseId])
  @@index([officeId, status])
  @@map("conflict_flags")
}

/// Najiz classification taxonomy (main → sub → leaf). Global reference data,
/// NOT tenant-scoped: the taxonomy is identical for every office. Seeded from
/// src/lib/najiz.ts.
model NajizClassification {
  id        String @id @default(uuid()) @db.Uuid
  mainClass String @map("main_class")
  subClass  String @map("sub_class")
  caseType  String @map("case_type")

  @@unique([mainClass, subClass, caseType])
  @@index([mainClass])
  @@map("najiz_classifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — documents: templates + generated/uploaded case documents.
// ─────────────────────────────────────────────────────────────────────────

/// A reusable legal-document template (prototype TEMPLATES). System templates
/// are seeded global (officeId null, isSystem) and available to every office;
/// an office may add its own. bodyTemplate holds {{placeholder}} text; fields
/// is the ordered field descriptor list (id/label/type/options/autofill/deny).
model DocumentTemplate {
  id       String  @id @default(uuid()) @db.Uuid
  officeId String? @map("office_id") @db.Uuid
  office   Office? @relation(fields: [officeId], references: [id])

  key          String
  title        String
  category     DocumentTemplateCategory
  /// Placeholder body ({{fieldId}} + the {{office}} token), rendered inside the letterhead.
  bodyTemplate String                   @map("body_template")
  /// Ordered field descriptors (Json): {id,label,type,options?,default?,autofill?,deny?}.
  fields       Json
  isSystem     Boolean                  @default(false) @map("is_system")
  isActive     Boolean                  @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  documents Document[]

  @@index([officeId])
  @@index([key])
  @@map("document_templates")
}

/// A case document — the unified document center (prototype case.docs[]). Every
/// origin (opening pack, hearing, client upload, template output, staff upload)
/// lands here, distinguished by `source`. Binary lives in object storage
/// (GCS Dammam / local dev); this row is the metadata + storage key.
model Document {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  office   Office @relation(fields: [officeId], references: [id])

  /// Nullable: a template doc may be generated standalone before saving to a case.
  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  fileName     String    @map("file_name")
  kind         DocKind   @default(DOCUMENT)
  source       DocSource
  party        DocParty?
  /// Free-text descriptor (صحيفة/محضر/مذكرة/مُولّد…), not an enforced enum.
  docType      String?   @map("doc_type")
  sessionLabel String?   @map("session_label")
  /// Soft link to a hearing (plain column, mirrors CaseEvent.actorUserId style).
  hearingId    String?   @map("hearing_id") @db.Uuid

  // ── stored object ──
  storageKey String  @map("storage_key")
  mimeType   String  @map("mime_type")
  sizeBytes  Int     @map("size_bytes")
  sha256     String?

  // ── template-generated docs ──
  templateId    String?           @map("template_id") @db.Uuid
  template      DocumentTemplate? @relation(fields: [templateId], references: [id])
  fieldValues   Json?             @map("field_values")
  renderedHtml  String?           @map("rendered_html")
  /// Frozen document date (BR-DOC-DATE-LOCALE) — re-rendering never changes it.
  generatedDate DateTime?         @map("generated_date")

  // ── text extraction (Phase-5 KB seam; produced here, indexed later) ──
  needsOcr      Boolean @default(false) @map("needs_ocr")
  extractedText String? @map("extracted_text")

  // ── client-portal sharing (Phase-8 seam) ──
  clientVisible    Boolean   @default(false) @map("client_visible")
  fromClient       Boolean   @default(false) @map("from_client")
  clientSharedAt   DateTime? @map("client_shared_at")
  clientSharedById String?   @map("client_shared_by") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([officeId, caseId])
  @@index([officeId, source])
  @@index([officeId, clientVisible])
  @@map("documents")
}
