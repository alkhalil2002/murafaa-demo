# ─── Database (Cloud SQL — Dammam me-central2 in prod; local Postgres in dev) ───
DATABASE_URL="postgresql://USER@localhost:5432/murafaa_dev?schema=public"

# ─── Auth ───
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-local-and-never-commit-the-real-one"

# ─── OTP provider ───
# console  → dev only, prints the code to the server log (no SMS sent)
# unifonic → Saudi SMS/WhatsApp provider (fill creds below)
OTP_PROVIDER="console"
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
# UNIFONIC_APP_SID=""
# UNIFONIC_SENDER_ID=""

# NOTE: never put secrets in client code or commit real values.
# In production these come from Google Secret Manager, not from .env.
