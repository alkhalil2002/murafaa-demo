# ─── Database (Cloud SQL — Dammam me-central2 in prod; local Postgres in dev) ───
DATABASE_URL="postgresql://USER@localhost:5432/murafaa_dev?schema=public"

# ─── Auth ───
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-local-and-never-commit-the-real-one"

# ─── OTP provider ───
# console  → dev only, prints the code to the server log (nothing is sent)
# whatsapp → production; POSTs [{ phone, otp }] to the outbound webhook
OTP_PROVIDER="console"
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
#
# WhatsApp webhook. Both are REQUIRED when OTP_PROVIDER=whatsapp and the app
# refuses to boot without them. The token is a live credential: set it in the
# host's secret store (Railway/Vercel variables, Google Secret Manager) — never
# in this file, never in a commit, never in client code.
# WHATSAPP_OTP_URL="https://camp-app.siyaq.io/outbound/webhook/<ID>"
# WHATSAPP_OTP_TOKEN=""

# ─── Document storage (src/lib/storage) ───
# local  → filesystem, no credentials (dev default; FATAL in production)
# volume → filesystem on a mounted persistent disk — Railway/Fly/VPS.
#          STORAGE_LOCAL_DIR must be the mount path. One replica only.
# gcs    → Google Cloud Storage, Dammam bucket (GCS_BUCKET then required)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
# GCS_BUCKET=""

# NOTE: never put secrets in client code or commit real values.
# In production these come from Google Secret Manager, not from .env.

# ─── AI cost controls ───
# Search uses NO AI at all (pure SQL LIKE in src/server/search.ts) and the KB
# embedder is an offline hash-based stub — neither costs anything.
#
# The only path that can make a paid API call is hearing-minutes drafting.
# It re-formats notes the lawyer already wrote and is forbidden from adding
# facts, so it runs on the cheapest adequate tier by default.
#   claude-haiku-4-5  $1/$5 per Mtok   ← default
#   claude-sonnet-5   $3/$15
#   claude-opus-5     $5/$25
# AI_DRAFT_MODEL="claude-haiku-4-5"

# ─── AI hearing-minutes drafting (dev-only fallback) ───
# Production uses Claude on Vertex AI (regional endpoint, docs/02 §6) once a
# GCP project + service account exist. Until then, setting this key locally
# activates the "✨ صِغ من الملاحظات" drafting button (src/lib/ai/hearing-draft.ts).
# ANTHROPIC_API_KEY=""
