{
  "name": "murafaa",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:generate": "pnpm --filter @murafaa/database generate",
    "db:migrate": "pnpm --filter @murafaa/database migrate",
    "sdk:generate": "pnpm --filter @murafaa/api openapi && pnpm --filter @murafaa/sdk generate",
    "db:seed": "pnpm --filter @murafaa/database seed",
    "db:seed:demo": "pnpm --filter @murafaa/api build && pnpm --filter @murafaa/api seed:demo",
    "db:reset": "pnpm --filter @murafaa/database reset"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
